{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "docker:pinDigests",
    ":configMigration",
    "security:minimumReleaseAgeNpm",
    ":maintainLockFilesWeekly"
  ],
  "labels": ["dependencies"],
  "prConcurrentLimit": 5,
  "packageRules": [
    {
      "description": "Dated Nitro RC. Bump it on purpose.",
      "matchPackageNames": ["nitro"],
      "enabled": false
    },
    {
      "description": "Ship runtime dependency updates through release-please.",
      "matchManagers": ["npm"],
      "matchDepTypes": ["dependencies"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "npm production non-major",
      "semanticCommitType": "fix",
      "semanticCommitScope": "deps"
    },
    {
      "matchManagers": ["npm"],
      "matchDepTypes": ["devDependencies"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "npm dev non-major",
      "semanticCommitType": "chore",
      "semanticCommitScope": "deps"
    },
    {
      "description": "Keep Playwright packages on the same version.",
      "matchPackageNames": ["playwright", "@playwright/test"],
      "groupName": "playwright",
      "semanticCommitType": "chore",
      "semanticCommitScope": "deps"
    },
    {
      "description": "Base-image digest updates should publish a new image.",
      "matchManagers": ["dockerfile", "docker-compose"],
      "semanticCommitType": "fix",
      "semanticCommitScope": "deps"
    },
    {
      "matchManagers": ["github-actions"],
      "groupName": "github-actions",
      "semanticCommitType": "chore",
      "semanticCommitScope": "deps"
    }
  ]
}
