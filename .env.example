PASSED_MAX_LENGTH=12288
# Maximum live shares. 0 opts in to unlimited (not recommended for public instances).
PASSED_MAX_SECRETS=4096
# On serverless platforms (Vercel, Cloudflare, Netlify) use PASSED_STORE_TYPE=upstash.
PASSED_STORE_TYPE=redis
# Redis 8+ (JSON in core). No AUTH is fine on 127.0.0.1; use redis://:password@... or rediss:// in production.
PASSED_STORE_REDIS_URL=redis://127.0.0.1:6379

# PASSED_STORE_TYPE=upstash
# PASSED_STORE_UPSTASH_URL=https://example.upstash.io
# PASSED_STORE_UPSTASH_TOKEN=

PORT=3000
